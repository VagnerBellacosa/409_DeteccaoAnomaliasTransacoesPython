1. Importação das Bibliotecas

import pandas as pd
import numpy as np

import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

2. Carregamento dos Dados

df = pd.read_csv('../dados/transacoes.csv')

df.head()

3. Conhecendo os Dados

df.info()
df.describe()
df.isnull().sum()

4. Distribuição dos Valores

plt.figure(figsize=(10,5))

sns.histplot(
    df['valor_transacao'],
    bins=30,
    kde=True
)

plt.title('Distribuição dos Valores das Transações')
plt.show()

5. Seleção das Variáveis

X = df[
    [
        'valor_transacao',
        'quantidade_itens',
        'tempo_cliente'
    ]
]

6. Padronização dos Dados

scaler = StandardScaler()

X_scaled = scaler.fit_transform(X)


7. Método do Cotovelo (Elbow Method)

wss = []

for k in range(1,11):

    modelo = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )

    modelo.fit(X_scaled)

    wss.append(modelo.inertia_)
    
8. Gráfico WSS

plt.figure(figsize=(10,5))

plt.plot(
    range(1,11),
    wss,
    marker='o'
)

plt.xlabel('Número de Clusters')
plt.ylabel('WSS')
plt.title('Método do Cotovelo')
plt.show()

9. Treinando o Modelo

modelo = KMeans(
    n_clusters=3,
    random_state=42,
    n_init=10
)

modelo.fit(X_scaled)

10. Identificando os Clusters

df['cluster'] = modelo.labels_

df.head()

11. Avaliando com Silhouette Score

score = silhouette_score(
    X_scaled,
    modelo.labels_
)

print(f'Silhouette Score: {score:.4f}')

12. Distância ao Centroide

distancias = modelo.transform(X_scaled)

df['distancia_centroide'] = np.min(
    distancias,
    axis=1
)

13. Definindo Anomalias

Selecionaremos os 5% registros mais distantes dos centroides.

limite = df['distancia_centroide'].quantile(0.95)

df['anomalia'] = (
    df['distancia_centroide'] > limite
)

14. Quantidade de Anomalias

df['anomalia'].value_counts()

15. Visualização dos Clusters

plt.figure(figsize=(10,6))

sns.scatterplot(
    data=df,
    x='valor_transacao',
    y='tempo_cliente',
    hue='cluster',
    palette='Set1'
)

plt.title('Clusters Encontrados')
plt.show()

16. Visualização das Anomalias

plt.figure(figsize=(12,6))

sns.scatterplot(
    data=df,
    x='valor_transacao',
    y='tempo_cliente',
    hue='anomalia',
    palette=['blue','red']
)

plt.title('Transações Suspeitas')
plt.show()

17. Exibindo Apenas as Anomalias

anomalias = df[df['anomalia'] == True]

anomalias.head(20)

18. Exportando Resultado

anomalias.to_csv(
    '../dados/anomalias_detectadas.csv',
    index=False
)

print('Arquivo gerado com sucesso!')

19. Conclusão

print('=' * 50)

print(f'Total de Transações: {len(df)}')

print(f'Anomalias Detectadas: {len(anomalias)}')

print(
    f'Percentual: '
    f'{len(anomalias)/len(df)*100:.2f}%'
)

print('=' * 50)
